# Veriflo AI - Regulatory Verification Engine Configuration

# -------------------------------------------------------------
# NVIDIA NIM (Inference Microservice) Configuration (Recommended)
# Get your API key from https://build.nvidia.com
# -------------------------------------------------------------
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Supported Models:
# - nvidia/nemotron-3.5-bolt-e4b (Recommended - Fast & Highly Accurate Structured Extraction)
# - nvidia/nemotron-3-nano-omni-30b-a3b-reasoning (Complex Reasoning)
# - deepseek-ai/deepseek-v4.1-flash (High Throughput)
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b

# -------------------------------------------------------------
# (Optional) Google Gemini API Key Fallback
# -------------------------------------------------------------
GEMINI_API_KEY=

# -------------------------------------------------------------
# Server Configuration
# -------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
