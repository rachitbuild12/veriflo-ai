# Veriflo AI - Regulatory Verification Engine Configuration

# -------------------------------------------------------------
# NVIDIA NIM (Inference Microservice) Configuration (Recommended)
# Get your API key from https://build.nvidia.com
# -------------------------------------------------------------
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Supported Models:
# - meta/llama-3.3-70b-instruct (Recommended, state-of-the-art reasoning)
# - nvidia/llama-3.1-nemotron-70b-instruct (High accuracy structured JSON)
# - meta/llama-3.1-8b-instruct (Ultra-low latency microservice)
# - meta/llama-3.2-11b-vision-instruct (Multimodal vision + document text)
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# -------------------------------------------------------------
# (Optional) Google Gemini API Key Fallback
# -------------------------------------------------------------
GEMINI_API_KEY=

# -------------------------------------------------------------
# Server Configuration
# -------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
